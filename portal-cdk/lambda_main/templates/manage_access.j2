{# djlint:off H006,H021 #}
<div>
    <legend>{{ labname }}</legend>
</div>
<div class="margin-left-30">
    <table>
        <tr class="tr-highlight">
            <th></th>
            <th style="padding: 10px;">Username</th>
            <th style="padding: 10px;">User Request Data</th>
            <th style="padding: 10px;">Request Status</th>
        </tr>
        {% for user in requests %}
            <tr>
                <td style="padding: 10px;">
                    <input type="button" value="Approve" style="background-color: green; color: white; border: 1px; padding: 5px 5px;"> | <input type="button" value="Reject" style="background-color: red; color: white; border: 1px; padding: 5px 5px;">
                </td>
                <td style="padding: 10px;">
                    <b><a href="/portal/profile/form/{{ user["username"] }}">{{ user["username"] }}</a></b>
                </td>
                <td style="padding: 10px;">
                    {{ user["request_data"] }}</a>
                </td>
                <td style="padding: 10px;">
                    {{ user["status"] }}</a>
                </td>
            </tr>
        {% endfor %}
    </table>
</div>