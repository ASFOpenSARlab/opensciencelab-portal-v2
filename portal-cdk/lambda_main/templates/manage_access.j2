{# djlint:off H006,H021 #}
<div class="margin-left-30">
    <table>
        <tr class="tr-highlight">
            <th style="padding: 10px;">Labname</th>
            <th style="padding: 10px;">Username</th>
            <th style="padding: 10px;">Request Status</th>
            <th style="padding: 10px;">User Request Date</th>
            <th style="padding: 10px;">Request Country</th>
        </tr>
        {% for request in requests %}
            <tr>
                <td style="padding: 10px;">
                    <a href="/portal/access/manage/{{ request["labname"] }}/requests/">{{ request["labname"] }}</a>
                </td>
                <td style="padding: 10px;">
                    <b><a href="/portal/profile/form/{{ request["username"] }}">{{ request["username"] }}</a></b>
                </td>
                <td style="padding: 10px;">{{ request["status"] }}</td>
                <td style="padding: 10px;">{{ request["answers"][-1]["submission_date"] }}</td>
                <td style="padding: 10px;">{{ request["answers"][-1]["submission_cc"] }}</td>
            </tr>
        {% endfor %}
    </table>
</div>
