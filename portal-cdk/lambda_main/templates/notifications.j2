<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" rel="stylesheet"/>
<style> #toast-container > div { opacity: 1; } </style>
<script type="module">
    import toastr from "https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js";
    function notifications(scope, tag) {

        toastr.options = {
            "closeButton": true,
            "newestOnTop": true,
            "progressBar": true,
            "preventDuplicates": false,
            "onclick": null,
            "showDuration": "30",
            "hideDuration": "10",
            "timeOut": "0",
            "extendedTimeOut": "0",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        }

        fetch(window.location.origin + '/notifications/'+encodeURIComponent(scope)+'?tag='+encodeURIComponent(tag) )
            .then( response => response.json() )
            .then( notifications => {
                console.log("Start toastr")
                console.log(notifications)
                notifications.forEach( (entry) => {
                    toastr.options.positionClass = "toast-"+entry["placement"]
                    toastr[entry['type']](entry['message'], entry['title'])
                })
            })
            .catch( error => console.log(error) )
    }

    notifications('portal', 'home')
</script>