{# djlint:off H006,H021 #}
<script src="/static/js/formutils.js" type="text/javascript" charset="utf-8"></script>
<!-- Forms -->
<form id="manage-role-form"
      action="/portal/users/manage-role"
      method="post">
    <input type="hidden" name="username" id="manage-role-username">
    <input type="hidden" name="action" id="manage-role-action">
    <input type="hidden" name="access-role" id="manage-role-access-role">
</form>
<script>
    function fillManageRoleForm(username, action, role){
        console.log(username)
        document.getElementById("manage-role-username").value = username;
        document.getElementById("manage-role-action").value = action;
        document.getElementById("manage-role-access-role").value = role;
    }
</script>
<div>
    {% if allows_requests %}
        <legend>
            {{ lab.friendly_name }} - <a href="/portal/access/manage/{{ lab.short_lab_name }}/requests/">Manage Access Requests</a>
        </legend>
    {% else %}
        <legend>{{ lab.friendly_name }}</legend>
    {% endif %}
    <div class="lab-logo">
        <span>
            {% if lab.logo is defined and lab.logo != None -%}
                <img class="lab-logo-img"
                     src="/static/img/{{ lab.logo }}"
                     alt="logo for {{ lab.friendly_name }}" />
            {% endif %}
        </span>
    </div>
</div>
{% if exceeded %}
    <div style="border: 2px solid red;
                background-color: lightcoral;
                width:95%;
                vertical-align: middle">
        <form action="/portal/access/manage/{{ lab.short_lab_name }}">
            Search results limited to {{ rowcount }}. Try filtering by username:
            <input type="input" name="user_filter">
            Or by email:
            <input type="input" name="email_filter">
            <input type="submit" hidden />
        </form>
    </div>
{% endif %}
<div class="margin-left-30">
    <h3>Tokens</h3>
    {% if lab.allows_tokens %}
        <table>
            <span id="error" style="color: red;"></span>
            <tr class="tr-highlight">
                <th>Token</th>
                <th>Profiles</th>
                <th>Start</th>
                <th>End</th>
                <th>Tools</th>
            </tr>
            <tr>
                <form method="post" action="{{ lab.short_lab_name }}/edittokens">
                    <th style="background-color: lightgrey;"></th>
                    <th>
                        <input type="text"
                               name="lab_profiles"
                               value="{{ ','.join(lab.default_profiles) }}">
                    </th>
                    <th>
                        <input type="date"
                               name="start_date"
                               id="start_date"
                               onchange="validateDateRange(this, document.getElementById('end_date'), document.getElementById('error'))">
                    </th>
                    <th>
                        <input type="date"
                               name="end_date"
                               id="end_date"
                               onchange="validateDateRange(document.getElementById('start_date'), this, document.getElementById('error'))">
                    </th>
                    <th>
                        <button type="submit" name="action" value="add_token">Add</button>
                    </th>
                </form>
            </tr>
            {% for token in access_tokens %}
                <tr>
                    <th>{{ token["value"] }}</th>
                    <th>
                        {% if "profiles" in token %}
                            {% for profile in token["profiles"] %}
                                <span style="border: 1px solid black; padding: 1px 4px; color: darkblue;">{{ profile }}</span>,
                            {% endfor %}
                        {% endif %}
                    </th>
                    <th>
                        {% if "start-date" in token %}{{ token["start-date"] }}{% endif %}
                    </th>
                    <th>
                        {% if "end-date" in token %}{{ token["end-date"] }}{% endif %}
                    </th>
                    <th>
                        <form method="post" action="{{ lab.short_lab_name }}/edittokens">
                            <input type="hidden" name="token" value="{{ token["value"] }}">
                            <button type="submit" name="action" value="remove_token">Remove</button>
                        </form>
                    </th>
                </tr>
            {% endfor %}
        </table>
    {% else %}
        <p>Tokens not enabled</p>
    {% endif %}
</div>
<div class="margin-left-30">
    <h3>Users</h3>
    <table>
        <tr class="tr-highlight">
            <th>Username</th>
            <th>Profiles</th>
            {% if lab.allows_tokens %}<th>Token</th>{% endif %}
            <th>Tools</th>
        </tr>
        <tr>
            <form method="post" action="{{ lab.short_lab_name }}/edituser">
                <th>
                    <input type="text" name="username" placeholder="username">
                </th>
                <th>
                    <input type="text"
                           name="lab_profiles"
                           value="{{ ','.join(lab.default_profiles) }}">
                </th>
                {% if lab.allows_tokens %}<th></th>{% endif %}
                <th>
                    <button type="submit" name="action" value="add_user">Add</button>
                </th>
            </form>
        </tr>
        {% for user in users %}
            <tr>
                <th>
                    <b><a href="/portal/profile/form/{{ user["username"] }}">{{ user["username"] }}</a></b>
                    <br>
                    <code>{{ user["email"] }}</code>
                </th>
                <th>
                    {% for profile in lab.allowed_profiles %}
                        {% if profile in user["labs"][lab.short_lab_name]["lab_profiles"] %}
                            <span style="border: 1px solid black; padding: 1px 4px; color: green;">{{ profile }}</span>,
                        {% else %}
                            <span style="border: 1px solid black; padding: 1px 4px; color: red;">{{ profile }}</span>,
                        {% endif %}
                    {% endfor %}
                </th>
                {% if lab.allows_tokens %}
                    <th>
                        {% if "token_usage" in user %}
                            {% for token in user["token_usage"] %}
                                {% if token["labname"] == lab.short_lab_name %}{{ token["token"] }}{% endif %}
                            {% endfor %}
                        {% endif %}
                    </th>
                {% endif %}
                <th>
                    <form method="post" action="{{ lab.short_lab_name }}/edituser">
                        <input type="hidden" name="username" value="{{ user['username'] }}">
                        <button type="submit" name="action" value="remove_user">Remove</button>
                    </form>
                </th>
            </tr>
        {% endfor %}
    </table>
</div>
<div class="margin-left-30">
    <div class="note">
        Notes on management Interface
        <ul>
            <li>Adding a user that already exists will overwrite their profile permissions</li>
            <li>
                Add several profiles as a comma separated list without quotations
                <br>
                EX: <code>m6a.large, m6a.xlarge</code>
            </li>
        </ul>
    </div>
</div>
