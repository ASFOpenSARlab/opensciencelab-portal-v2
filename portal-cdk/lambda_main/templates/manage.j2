{# djlint:off H006,H021 #}
<script src="/static/js/formutils.js" type="text/javascript" charset="utf-8"></script>
<!-- Forms -->
<form id="remove-user-form"
      method="post"
      action="{{ lab.short_lab_name }}/edituser">
    <input type="hidden" name="action" value="remove_user">
    <input type="hidden" name="username" id="remove-user-username">
</form>
<form id="manager-form"
      method="post"
      action="{{ lab.short_lab_name }}/editmanager">
    <input type="hidden" name="action" id="manager-form-action">
    <input type="hidden" name="username" id="manager-username">
</form>
<script>
    function fillRemoveUserForm(labname, username){
        document.getElementById("remove-user-form").action = `${labname}/edituser`
        document.getElementById("remove-user-username").value = username;
    }
    function fillManagerForm(action, username, labname){
        document.getElementById("manager-form").action = `${labname}/editmanager`
        document.getElementById("manager-form-action").value = action;
        document.getElementById("manager-username").value = username;
    }
</script>
<div>
    {% if allows_requests %}
        <legend>
            {{ lab.friendly_name }} - <a href="/portal/access/manage/{{ lab.short_lab_name }}/requests/">Manage Access Requests</a>
        </legend>
    {% else %}
        <legend>{{ lab.friendly_name }}</legend>
    {% endif %}
    <div class="lab-logo">
        <span>
            {% if lab.logo is defined and lab.logo != None -%}
                <img class="lab-logo-img"
                     src="/static/img/{{ lab.logo }}"
                     alt="logo for {{ lab.friendly_name }}" />
            {% endif %}
        </span>
    </div>
</div>
{% include "filters.j2" %}
<div class="margin-left-30">
    <h3>Tokens</h3>
    {% if lab.allows_tokens %}
        <table>
            <span id="error" style="color: red;"></span>
            <tr class="tr-highlight">
                <th>Token</th>
                <th>Profiles</th>
                <th>Start</th>
                <th>End</th>
                <th>Tools</th>
            </tr>
            <tr>
                <form method="post" action="{{ lab.short_lab_name }}/edittokens">
                    <th style="background-color: lightgrey;"></th>
                    <th>
                        <input type="text"
                               name="lab_profiles"
                               value="{{ ','.join(lab.default_profiles) }}">
                    </th>
                    <th>
                        <input type="date"
                               name="start_date"
                               id="start_date"
                               onchange="validateDateRange(this, document.getElementById('end_date'), document.getElementById('error'))">
                    </th>
                    <th>
                        <input type="date"
                               name="end_date"
                               id="end_date"
                               onchange="validateDateRange(document.getElementById('start_date'), this, document.getElementById('error'))">
                    </th>
                    <th>
                        <button type="submit" name="action" value="add_token">Add</button>
                    </th>
                </form>
            </tr>
            {% for token in access_tokens %}
                <tr>
                    <th>{{ token["value"] }}</th>
                    <th>
                        {% if "profiles" in token %}
                            {% for profile in token["profiles"] %}
                                <span style="border: 1px solid black; padding: 1px 4px; color: darkblue;">{{ profile }}</span>,
                            {% endfor %}
                        {% endif %}
                    </th>
                    <th>
                        {% if "start-date" in token %}{{ token["start-date"] }}{% endif %}
                    </th>
                    <th>
                        {% if "end-date" in token %}{{ token["end-date"] }}{% endif %}
                    </th>
                    <th>
                        <form method="post" action="{{ lab.short_lab_name }}/edittokens">
                            <input type="hidden" name="token" value="{{ token["value"] }}">
                            <button type="submit" name="action" value="remove_token">Remove</button>
                        </form>
                    </th>
                </tr>
            {% endfor %}
        </table>
        <div class="note">
            Notes on Token Interface
            <ul>
                <li>
                    Token profiles are specified as a comma-separated list, without spaces (you can copy-paste from the "Users" table).
                    <br>
                    Ex.: <code>m6a.large, m6a.xlarge</code>
                </li>
                <li>All tokens will be unique, random strings.</li>
                <li>
                    You can optionally specify a start and/or end date -- tokens will become enabled/disabled at 00:00 UTC on the specified day.
                    If you don't specify either one, they will be valid for all of the past or future.
                </li>
            </ul>
        </div>
    {% else %}
        <p>Tokens not enabled</p>
    {% endif %}
</div>
<div class="margin-left-30">
    <h3>Users</h3>
    <div class="margin-left-30">
        <div class="note">
            Notes on Management Interface
            <ul>
                <li>Adding a user that already exists will overwrite their profile permissions</li>
                <li>
                    Add several profiles as a comma separated list without quotations (you can copy-paste from the table)
                    <br>
                    Ex.: <code>m6a.large, m6a.xlarge</code>
                </li>
            </ul>
        </div>
    </div>
    <table id="user-table">
        <tr class="tr-highlight">
            <th>Username</th>
            <th>Profiles</th>
            {% if lab.allows_tokens %}<th>Token</th>{% endif %}
            <th>Tools</th>
        </tr>
        <tr>
            <form method="post" action="{{ lab.short_lab_name }}/edituser">
                <th>
                    <input type="text" name="username" placeholder="username" required>
                </th>
                <th>
                    <input type="text"
                           name="lab_profiles"
                           value="{{ ','.join(lab.default_profiles) }}"
                           required>
                </th>
                {% if lab.allows_tokens %}<th></th>{% endif %}
                <th>
                    <button type="submit" name="action" value="add_user">Add</button>
                </th>
            </form>
        </tr>
    </table>
</div>
<script>
    function renderMoreUsers(users) {
        const table = document.getElementById("user-table");
        const fragment = document.createDocumentFragment();
        for(idx in users) {
            const user = users[idx];
            const row = document.createElement("tr");
            // Render profiles
            const allowed_profiles = {{ lab.allowed_profiles }};
            let profiles = ""
            for(const profile of allowed_profiles){
                if (user["labs"]["{{ lab.short_lab_name }}"]["lab_profiles"].includes(profile)){
                    profiles += `<span style="border: 1px solid black; padding: 1px 4px; color: green;">${ profile }</span>`
                }else{
                    profiles += `<span style="border: 1px solid black; padding: 1px 4px; color: red;">${ profile }</span>`
                }
            }
            // Render tools
            let tools = `
                <button form="remove-user-form" type="submit" class="warning-background" onclick="fillRemoveUserForm('{{ lab.short_lab_name }}', '${ user["username"] }');">
                    Remove
                </button>`
            if({{ managers }}.includes(user["username"])){
                tools += `
                <button form="manager-form" type="submit" class="warning-background" onclick="fillManagerForm('revoke', '${ user["username"] }', '{{ lab.short_lab_name }}');">
                    Revoke Manager
                </button>`
            }else{
                tools += `
                <button form="manager-form" type="submit" class="success-background" onclick="fillManagerForm('grant', '${ user["username"] }', '{{ lab.short_lab_name }}');">
                    Grant Manager
                </button>`
            }
            let token_row = "";
            if({{ 'true' if lab.allows_tokens else 'false' }}){
                if("token_usage" in user){
                    for(token of user["token_usage"]){
                        if(token["labname"] == "{{ lab.short_lab_name }}"){
                            token_row += `<p>${token["token"]}</p>`;
                        }
                    }
                }
                token_row = `<th>${token_row}</th>`
            }
            row.innerHTML =`
            <th>
                {% if is_admin %}
                    <b><a href="/portal/profile/form/${ user["username"] }">${ user["username"] }</a></b>
                {% else %}
                    <b>${ user["username"] }</b>
                {% endif %}
                <br>
                <code>${ user["email"] }</code>
            </th>
            <th>
                ${profiles}
            </th>
            ${token_row}
            <th>
                <div class="horizontal-div">
                    ${tools}
                </div>
            </th>
            `;
            fragment.appendChild(row);
        };
        table.appendChild(fragment);
    }
    let foundAllUsers = false;
    let lastEvaluatedKey = null;
    let isLoading = false;
    const params = new URLSearchParams(window.location.search);
    const user_filter = params.get("user_filter");
    const email_filter = params.get("email_filter");
    async function fetchUsers() {
        if(isLoading || foundAllUsers) return;
        isLoading = true;
        try{
            // Build Url
            console.log(user_filter, email_filter)
            const url = new URL('/portal/access/manage/{{ lab.short_lab_name }}/get-users', window.location.origin);
            if (lastEvaluatedKey){
                url.searchParams.append('primary_key', Object.keys(lastEvaluatedKey)[0]);
                url.searchParams.append('key_value', Object.values(lastEvaluatedKey)[0]);
            }
            if(user_filter){
                url.searchParams.append("user_filter", user_filter);
            }
            if(email_filter){
                url.searchParams.append("email_filter", email_filter);
            }
            // Fetch users
            const response = await fetch(url.toString());
            const data = await response.json();

            if (!data.lastEvaluatedKey){
                foundAllUsers = true;
            }
            console.log(data)
            lastEvaluatedKey = data.lastEvaluatedKey
            renderMoreUsers(data.users)

        } catch (error) {
            console.error('Error fetching users:', error);
        } finally {
            isLoading = false;
        }
    }
    function handleScroll() {
        const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
        // Check if user has scrolled to the bottom
        if (scrollTop + clientHeight >= scrollHeight - 500) {
            fetchUsers();
        }
    }
    window.addEventListener('load', async () => {
        await fetchUsers();
        window.addEventListener('scroll', handleScroll);
    });
</script>