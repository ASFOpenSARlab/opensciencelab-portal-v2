<!DOCTYPE html>
<html lang="en">
    <head>
        <title>OpenScienceLab Email Error</title>
        <meta charset="utf-8" />
        <meta name="keywords" content="OpenScienceLab, SAR">
        <meta name="description"
              content="Sometimes we just need butter with popcorn.">
    </head>
    <body>
        <h1>Message from OpenScienceLab</h1>
        <section>
            <p>There was an error while sending an email...</p>
        </section>
        <section>
            <pre>{{ error }}</pre>
        </section>
        <section>
            <p>
                {% if "username" in request_data["to"] %}
                    <b>Username</b>: {{ request_data["to"]["username"] }}<br>
                {% endif %}
                {% if "email" in request_data["to"] %}
                    <b>Email</b>: {{ request_data["to"]["email"] }}<br>
                {% endif %}
                <b>Email Subject</b>: {{ request_data["subject"] }}
            </p>
        </section>
        <section>
            <p>Consult AWS logs for more info.</p>
        </section>
    </body>
</html>
