{# djlint:off H016,H021,H030,H031 #}
{% include 'voice-atlas.j2' %}
{% with -%}
    {% set scope = "portal" %}
    {% set tag = "application" %}
    {% include 'notifications.j2' %}
{% endwith -%}
<script src="/static/js/formutils.js" type="text/javascript" charset="utf-8"></script>
<div class="content-wrapper">
    <div class="margin-left-50">
        <h2>
            <i>{{ lab_friendly_name }}</i> Application
        </h2>
        <div class="center-horizontal">
            <form method="post">
                {% for question in application_questions -%}
                    <label for={{ question["name"] }}
                    {% if question.get("rendering_options") and question.get("rendering_options") in ["multi-line"] %}
                    style="display: block; margin-bottom: 8px;"
                    {% endif %}>
                        {{ question["question"] }}
                    </label>
                    {% if question["type"] == "text" %}
                        {% if question["rendering_options"] == "multi-line" %}
                            <textarea
                                id={{ question["name"] }}
                                name={{ question["name"] }}
                                rows="4" cols="50"
                                {% if question.get("placeholder") %}
                                placeholder="{{ question["placeholder"] }}"
                                {% endif %}
                                ></textarea>
                        {% else %}
                            <input
                                type="text"
                                id={{ question["name"] }}
                                name={{ question["name"] }}
                                {% if question.get("placeholder") %}
                                placeholder={{ question["placeholder"] }}
                                {% endif %}
                                >
                        {% endif %}
                    {% elif question["type"] == "checkbox" %}
                        <input
                            type="checkbox"
                            id={{ question["name"] }}
                            name={{ question["name"] }}>
                    {% elif question["type"] == "dropdown" %}
                        <select
                            id={{ question["name"] }}
                            name={{ question["name"] }}
                            onchange="removeDropdownDefault(this)">
                                <option value="default">Choose One</option>
                                {% for option in question["rendering_options"] %}
                                    <option value={{ option|lower }}>{{ option }}</option>
                                {% endfor %}
                        </select>
                    {% endif %}
                    <br>
                    <br>
                {% endfor %}
                <!-- Sumbit button -->
                <div>
                    <button type="submit">Submit Your Answers</button>
                </div>
            </form>
        </div>
    </div>
</div>