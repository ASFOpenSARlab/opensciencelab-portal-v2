{# 
    remove H025 after multiline jinja comment dealth with 
    inside of <a> tag with id="start-{{ currentlab.short_lab_name }}"
#}
{% with -%}
    {% set scope = "portal" %}
    {% set tag = "home" %}
    {% include 'notifications.j2' %}
{% endwith -%}
<div class="container margin-top-10">
    <h2 class="title">Welcome To OpenScienceLab</h2>
    <p>
        <i>
            For an overview of best practices and guidance for resolving some issues,
            see the <a href="https://opensarlab-docs.asf.alaska.edu/">OpenScienceLab documentation</a>.
            <br />
            If you need assistance, don't hesitate to <a href="mailto:uaf-jupyterhub-asf+help@alaska.edu">email the OpenScienceLab team</a>.
            Please include your username, which lab deployment and profile was used, a detailed description,
            and any other information that you feel is needed.
        </i>
    </p>
</div>
{% for labname, access in labs["lab_access"].items()|sort(attribute='1.can_user_access_lab', reverse=true) %}
    {% set accessable = labs["lab_access"][labname]["can_user_access_lab"] %}
    {% set lab = labs["viewable_labs_config"][labname] %}
    {% set lab_config = lab.get_lab_config() %}
    {% if labs["lab_access"][labname]["can_user_see_lab"] %}
        <div class="container margin-top-10">
            <div class="row">
                <section>
                    <div id="lab-choices">
                        {% if accessable %}
                            <fieldset class="fieldset-border-blue">
                            {% else %}
                                <fieldset class="fieldset-border-red">
                                {% endif %}
                                <legend class="legend-border-text font-30">{{ lab_config.friendly_name }}</legend>
                                {% if not lab_config.is_healthy() -%}
                                    <p class="alert alert-danger show">
                                        The lab url is either unhealthy or no longer exists. Please contact the <a href="mailto:uaf-jupyterhub-asf+help@alaska.edu">OpenScienceLab Team</a>.
                                        <br />
                                    </p>
                                {% endif %}
                                <div class="lab-logo">
                                    <span>
                                        {% if lab_config.logo is defined and lab_config.logo != None -%}
                                            <img class="lab-logo-img"
                                                 src="/static/img/{{ lab_config.logo }}"
                                                 alt="logo for {{ lab_config.friendly_name }}" />
                                        {% endif %}
                                    </span>
                                </div>
                                <div class="vertical-div">
                                    <div class="lab-description">
                                        <span>{{ lab_config.description | safe }}</span>
                                    </div>
                                    <div class="lab-btns">
                                        {% if admin %}
                                            <a id="about-{{ lab_config.short_lab_name }}"
                                               role="button"
                                               class="btn btn-lg btn-primary go-to-about-btn"
                                               href="/portal/access/manage/{{ lab_config.short_lab_name }}">Manage</a>
                                        {% endif %}
                                        {% if lab_config.about_page_url is defined and lab_config.about_page_url != None -%}
                                            <a id="about-{{ lab_config.short_lab_name }}"
                                               role="button"
                                               class="btn btn-lg btn-primary go-to-about-btn"
                                               target="_blank"
                                               href="{{ lab_config.about_page_url }}">{{ lab_config.about_page_button_label }}</a>
                                        {% endif %}
                                        <a id="start-{{ lab_config.short_lab_name }}"
                                           role="button"
                                           class="btn btn-lg btn-primary go-to-lab-btn"
                                           {% if not accessable -%}
                                           {% if lab_config.application_questions is defined and lab_config.application_questions != [] and (lab.get_access_request(username) is not mapping or lab.get_access_request(username)["status"] != "rejected") %}
                                           href="/portal/access/apply/{{ lab_config.short_lab_name }}"
                                           title="Apply to lab">
                                            <i>Apply for Access</i>
                                        {% else %}
                                            href="#"
                                            title="You do not have access to the lab"
                                            disabled>
                                            <i>Restricted</i>
                                        {% endif %}
                                    {% elif not lab_config.is_healthy() -%}
                                        href="#"
                                        title="The lab url is either unhealthy or the lab no longer exists"
                                        disabled
                                        >
                                        <i>Unavailable</i>
                                    {% else -%}
                                        href="/lab/{{ lab_config.short_lab_name }}/hub/login"
                                        title="Click to go to the lab {{ lab_config.short_lab_name }}"
                                        >
                                        <i>Go to lab</i>
                                    {% endif %}
                                </a>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </section>
        </div>
    </div>
    <br>
    <br>
{% endif %}
{% endfor %}
